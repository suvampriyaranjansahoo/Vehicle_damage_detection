# Local model is used by default.
MODEL_PATH=model/car_damage_model.keras
MODEL_CACHE_DIR=.cache
MAX_UPLOAD_BYTES=8388608
MODEL_VERSION=1.0.0
PREDICTION_LOG_PATH=artifacts/predictions.jsonl
API_URL=http://localhost:8000

# Optional remote model source for deployments that keep weights outside Git.
# If MODEL_PATH exists, it takes precedence.
MODEL_URL=
HF_MODEL_ID=
HF_MODEL_FILENAME=car_damage_model.keras
